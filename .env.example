# AeroPrep environment sample. Do not commit real secrets.

# Runtime mode
NODE_ENV=development

# Database connection for Prisma
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/studyhub_dev

# NextAuth configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-secret-of-at-least-32-characters
# AUTH_SECRET is supported as an alias for NEXTAUTH_SECRET when present
AUTH_SECRET=

# Optional runtime port override
PORT=3000

# AI provider selection: mock, openai, anthropic, gemini, google-gemini
AI_PROVIDER=mock

# OpenAI environment variables
OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_MODEL=gpt-4.1-mini

# Anthropic environment variables
ANTHROPIC_API_KEY=replace-with-anthropic-api-key
ANTHROPIC_MODEL=claude-3.5

# Google Gemini environment variables
GOOGLE_GEMINI_API_KEY=replace-with-google-gemini-api-key
GOOGLE_GEMINI_MODEL=gemini-1.5
GOOGLE_API_KEY=replace-with-google-api-key
GOOGLE_CLOUD_API_KEY=replace-with-google-cloud-api-key

# File upload limits
MAX_MEDIA_UPLOAD_SIZE_BYTES=10485760

# Optional admin account seed password for local development only
ADMIN_PASSWORD=AeroPrep@2025

# Test environment flag
VITEST=false

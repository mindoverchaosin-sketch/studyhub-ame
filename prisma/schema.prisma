generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum RoleName {
  STUDENT
  ADMIN
  INSTRUCTOR
  CONTENT_EDITOR
  SUPER_ADMIN
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum Status {
  DRAFT
  PUBLISHED
  ARCHIVED
  SCHEDULED
}

enum ProductType {
  BUNDLE
  COURSE
  SUBSCRIPTION
  ACCESS_PACK
}

enum AccessType {
  FREE
  PURCHASE
  BUNDLE
  SUBSCRIPTION
  ADMIN
  PROMOTION
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  PAUSED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  FAILED
  CANCELLED
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  SHORT_ANSWER
}

enum StudyMaterialType {
  VIDEO
  PDF
  NOTES
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  displayName  String?
  isActive     Boolean   @default(true)
  roleId       String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  role             Role?             @relation(fields: [roleId], references: [id], onDelete: Restrict)
  studentProfile   StudentProfile?
  adminProfile     AdminProfile?
  sessions         Session[]
  notifications    Notification[]
  auditLogs        AuditLog[]
  enrollments      Enrollment[]
  progress         Progress[]
  lessonProgress   LessonProgress[]
  moduleProgress   ModuleProgress[]
  quizAttempts     QuizAttempt[]
  mockTestAttempts MockTestAttempt[]
  bookmarks        Bookmark[]
  studyStreak      StudyStreak?
  achievements     Achievement[]
  certificates     Certificate[]
  purchases        Purchase[]
  orders           Order[]
  entitlements     Entitlement[]
  subscriptions    Subscription[]      @relation("userSubscriptions")
  aiConversations  AIConversation[]

  @@index([email])
  @@index([isActive])
  @@index([roleId])
}

model Role {
  id          String    @id @default(uuid())
  name        RoleName  @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  users       User[]
  permissions RolePermission[]

  @@index([name])
}

model Permission {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  roles RolePermission[]

  @@index([name])
}

model RolePermission {
  roleId       String
  permissionId String
  userId       String?

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model StudentProfile {
  id         String    @id @default(uuid())
  userId     String    @unique
  fullName   String
  targetExam String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AdminProfile {
  id          String    @id @default(uuid())
  userId      String    @unique
  fullName    String
  department  String?
  permissions Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Session {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType @default(INFO)
  title     String
  body      String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  deletedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
}

model AIConversation {
  id         String      @id @default(uuid())
  userId     String?
  title      String
  metadata   Json?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  deletedAt  DateTime?

  user     User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  messages AIMessage[]

  @@index([userId])
  @@index([title])
}

model AIMessage {
  id             String      @id @default(uuid())
  conversationId String
  role           String
  content        String
  finishReason   String?
  usage          Json?
  model          String?
  metadata       Json?
  createdAt      DateTime    @default(now())

  conversation AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model AuditLog {
  id          String    @id @default(uuid())
  actorUserId String
  action      String
  targetType  String
  targetId    String
  metadata    Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  user User @relation(fields: [actorUserId], references: [id], onDelete: Cascade)

  @@index([actorUserId])
  @@index([targetType])
}

model Category {
  id          String    @id @default(uuid())
  slug        String    @unique
  title       String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  courses Course[]

  @@index([slug])
}

model Tag {
  id        String    @id @default(uuid())
  slug      String    @unique
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  courseTags CourseTag[]

  @@index([slug])
}

model Course {
  id          String    @id @default(uuid())
  slug        String    @unique
  title       String
  description String?
  categoryId  String?
  status      Status    @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  category    Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  modules     Module[]
  mockTests   MockTest[]
  enrollments Enrollment[]
  progress    Progress[]
  courseTags  CourseTag[]

  @@index([categoryId])
  @@index([status])
}

model CourseTag {
  courseId String
  tagId    String

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([courseId, tagId])
  @@index([tagId])
}

model Module {
  id             String     @id @default(uuid())
  courseId       String
  slug           String     @unique
  title          String
  moduleNumber   String     @default("0")
  description    String?
  difficulty     Difficulty @default(BEGINNER)
  estimatedHours Int        @default(0)
  displayOrder   Int        @default(0)
  status         Status     @default(DRAFT)
  publishedAt    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  deletedAt      DateTime?

  course             Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons            Lesson[]
  studyMaterials     StudyMaterial[]
  lessonsProgress    ModuleProgress[]
  learningObjectives LearningObjective[]
  quizzes            Quiz[]

  @@index([courseId])
  @@index([displayOrder])
  @@index([status])
}

model Lesson {
  id              String    @id @default(uuid())
  moduleId        String
  slug            String    @unique
  title           String
  description     String?
  durationMinutes Int       @default(0)
  displayOrder    Int       @default(0)
  status          Status    @default(DRAFT)
  publishedAt     DateTime?
  metadata        Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  module         Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  studyMaterials StudyMaterial[]
  lessonProgress LessonProgress[]

  @@index([moduleId])
  @@index([displayOrder])
}

model StudyMaterial {
  id           String            @id @default(uuid())
  moduleId     String?
  lessonId     String?
  title        String
  materialType StudyMaterialType @default(PDF)
  url          String
  isPremium    Boolean           @default(false)
  status       Status            @default(DRAFT)
  publishedAt  DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  deletedAt    DateTime?

  module Module? @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  lesson Lesson? @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([moduleId])
  @@index([lessonId])
  @@index([materialType])
}

model Quiz {
  id               String    @id @default(uuid())
  moduleId         String
  title            String
  description      String?
  timeLimitMinutes Int       @default(0)
  passingScore     Int       @default(70)
  status           Status    @default(DRAFT)
  publishedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  module        Module         @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  questionBanks QuestionBank[]
  attempts      QuizAttempt[]

  @@index([moduleId])
}

model MockTest {
  id          String    @id @default(uuid())
  courseId    String
  title       String
  description String?
  status      Status    @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  course        Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  questionBanks QuestionBank[]
  attempts      MockTestAttempt[]

  @@index([courseId])
}

model QuestionBank {
  id          String    @id @default(uuid())
  title       String
  description String?
  status      Status    @default(DRAFT)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  questions Question[]
  quizzes   Quiz[]
  mockTests MockTest[]

  @@index([status])
}

model Question {
  id                 String       @id @default(uuid())
  questionBankId     String
  prompt             String
  questionType       QuestionType @default(MULTIPLE_CHOICE)
  options            Json?
  correctOptionIndex Int?
  explanation        String?
  difficulty         Difficulty   @default(BEGINNER)
  status             Status       @default(DRAFT)
  metadata           Json?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  deletedAt          DateTime?

  questionBank QuestionBank @relation(fields: [questionBankId], references: [id], onDelete: Cascade)

  @@index([questionBankId])
  @@index([difficulty])
}

model ExamTemplate {
  id                     String    @id @default(uuid())
  name                   String
  description            String?
  questionBankId         String?
  moduleId               String?
  courseId               String?
  durationMinutes        Int       @default(60)
  questionCount          Int       @default(20)
  passingPercentage      Int       @default(60)
  shuffleQuestions       Boolean   @default(false)
  shuffleAnswers         Boolean   @default(false)
  negativeMarkingEnabled Boolean   @default(false)
  active                 Boolean   @default(false)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([questionBankId])
  @@index([active])
}

model ExamAttempt {
  id          String   @id @default(uuid())
  studentId   String
  templateId  String
  status      Status   @default(DRAFT)
  startedAt   DateTime?
  submittedAt DateTime?
  expiresAt   DateTime?
  score       Float?
  percentage  Float?
  passed      Boolean?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([studentId])
  @@index([templateId])
}

model ExamAttemptQuestion {
  id           String @id @default(uuid())
  attemptId    String
  questionId   String
  displayOrder Int

  @@index([attemptId])
  @@index([questionId])
}

model ExamAttemptAnswer {
  id                String @id @default(uuid())
  attemptQuestionId String
  selectedOption    Int?
  bookmarked        Boolean @default(false)
  markedForReview   Boolean @default(false)
  answeredAt        DateTime?

  @@index([attemptQuestionId])
}

model LearningObjective {
  id          String    @id @default(uuid())
  moduleId    String
  description String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@index([moduleId])
}

model Enrollment {
  id         String    @id @default(uuid())
  userId     String
  courseId   String
  status     Status    @default(DRAFT)
  enrolledAt DateTime  @default(now())
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([status])
}

model Progress {
  id                String         @id @default(uuid())
  userId            String
  courseId          String
  completionPercent Int            @default(0)
  status            ProgressStatus @default(NOT_STARTED)
  updatedAt         DateTime       @updatedAt
  createdAt         DateTime       @default(now())
  deletedAt         DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([status])
}

model LessonProgress {
  id              String         @id @default(uuid())
  userId          String
  lessonId        String
  status          ProgressStatus @default(NOT_STARTED)
  percentComplete Int            @default(0)
  updatedAt       DateTime       @updatedAt
  createdAt       DateTime       @default(now())
  deletedAt       DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([status])
}

model ModuleProgress {
  id              String         @id @default(uuid())
  userId          String
  moduleId        String
  status          ProgressStatus @default(NOT_STARTED)
  percentComplete Int            @default(0)
  updatedAt       DateTime       @updatedAt
  createdAt       DateTime       @default(now())
  deletedAt       DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleId])
  @@index([status])
}

model QuizAttempt {
  id          String    @id @default(uuid())
  userId      String
  quizId      String
  score       Int       @default(0)
  passed      Boolean   @default(false)
  attemptedAt DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([quizId])
}

model MockTestAttempt {
  id          String    @id @default(uuid())
  userId      String
  mockTestId  String
  score       Int       @default(0)
  passed      Boolean   @default(false)
  attemptedAt DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mockTest MockTest @relation(fields: [mockTestId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([mockTestId])
}

model Bookmark {
  id         String    @id @default(uuid())
  userId     String
  resourceId String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model StudyStreak {
  id            String    @id @default(uuid())
  userId        String    @unique
  currentStreak Int       @default(0)
  longestStreak Int       @default(0)
  updatedAt     DateTime  @updatedAt
  createdAt     DateTime  @default(now())
  deletedAt     DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Achievement {
  id        String    @id @default(uuid())
  userId    String
  title     String
  earnedAt  DateTime  @default(now())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Certificate {
  id        String    @id @default(uuid())
  userId    String
  courseId  String
  issuedAt  DateTime  @default(now())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([courseId])
}

model Product {
  id          String      @id @default(uuid())
  slug        String      @unique
  name        String
  type        ProductType @default(COURSE)
  description String?
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?

  prices     ProductPrice[]
  purchases  Purchase[]
  orderItems OrderItem[]
  bundles    BundleProduct[]

  @@index([type])
}

model ProductPrice {
  id        String    @id @default(uuid())
  productId String
  amount    Decimal   @db.Decimal(10, 2)
  currency  String    @default("INR")
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  product           Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  subscriptionPlans SubscriptionPlan[]

  @@index([productId])
}

model Order {
  id            String        @id @default(uuid())
  userId        String
  status        OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(PENDING)
  currency      String        @default("INR")
  totalAmount   Decimal       @db.Decimal(10, 2)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]
  discounts  Discount[]
  purchases  Purchase[]

  @@index([userId])
  @@index([status])
}

model OrderItem {
  id         String    @id @default(uuid())
  orderId    String
  productId  String
  quantity   Int       @default(1)
  unitPrice  Decimal   @db.Decimal(10, 2)
  totalPrice Decimal   @db.Decimal(10, 2)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
}

model Purchase {
  id          String    @id @default(uuid())
  userId      String
  productId   String
  orderId     String?
  purchasedAt DateTime  @default(now())
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([productId])
}

model SubscriptionPlan {
  id             String    @id @default(uuid())
  slug           String    @unique
  name           String
  interval       String    @default("monthly")
  productPriceId String
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  productPrice   ProductPrice   @relation(fields: [productPriceId], references: [id], onDelete: Restrict)
  subscriptions  Subscription[]

  @@index([slug])
}

model Bundle {
  id        String    @id @default(uuid())
  slug      String    @unique
  name      String
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  products BundleProduct[]

  @@index([slug])
}

model BundleProduct {
  bundleId  String
  productId String

  bundle  Bundle  @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([bundleId, productId])
  @@index([productId])
}

model Entitlement {
  id         String     @id @default(uuid())
  userId     String
  resourceId String
  accessType AccessType @default(PURCHASE)
  sourceId   String?
  grantedAt  DateTime   @default(now())
  expiresAt  DateTime?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  deletedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([resourceId])
}

model Coupon {
  id            String    @id @default(uuid())
  code          String    @unique
  discountType  String    @default("percentage")
  discountValue Decimal   @db.Decimal(10, 2)
  isActive      Boolean   @default(true)
  expiresAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  discounts Discount[]

  @@index([code])
}

model Discount {
  id          String    @id @default(uuid())
  orderId     String
  couponId    String?
  amount      Decimal   @db.Decimal(10, 2)
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  order  Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  coupon Coupon? @relation(fields: [couponId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([couponId])
}

model AccessPolicy {
  id          String     @id @default(uuid())
  resourceId  String
  policyType  AccessType @default(FREE)
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime?

  @@index([resourceId])
  @@index([policyType])
}

model Subscription {
  id                 String               @id @default(uuid())
  userId             String
  subscriptionPlanId String
  status             SubscriptionStatus   @default(ACTIVE)
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  renewalAttempts    Int                  @default(0)
  cancelledAt        DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  deletedAt          DateTime?

  user               User                 @relation("userSubscriptions", fields: [userId], references: [id], onDelete: Cascade)
  subscriptionPlan   SubscriptionPlan     @relation(fields: [subscriptionPlanId], references: [id], onDelete: Restrict)
  invoices           Invoice[]

  @@index([userId])
  @@index([subscriptionPlanId])
  @@index([status])
}

model Invoice {
  id              String        @id @default(uuid())
  subscriptionId  String
  invoiceNumber   String        @unique
  status          InvoiceStatus @default(DRAFT)
  dueDate         DateTime?
  paidAt          DateTime?
  amount          Decimal       @db.Decimal(10, 2)
  currency        String        @default("INR")
  description     String?
  metadata        Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@index([status])
  @@index([invoiceNumber])
}

